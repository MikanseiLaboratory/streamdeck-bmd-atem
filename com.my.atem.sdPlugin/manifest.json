{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 2,
  "Author": "streamdeck-atem-rs",
  "CodePath": "streamdeck-atem",
  "CodePathMac": "streamdeck-atem",
  "CodePathWin": "streamdeck-atem.exe",
  "Description": "Control Blackmagic ATEM switchers from Stream Deck.",
  "Icon": "Images/icon",
  "Name": "ATEM Control",
  "Version": "0.1.0",
  "UUID": "com.my.atem",
  "OS": [
    { "Platform": "mac", "MinimumVersion": "10.15" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Software": { "MinimumVersion": "6.0" },
  "Actions": [
    {
      "UUID": "com.my.atem.action",
      "Icon": "Images/icon",
      "Name": "ATEM Action",
      "PropertyInspectorPath": "PropertyInspector/index.html",
      "States": [
        { "Image": "Images/icon", "TitleAlignment": "middle" }
      ],
      "Tooltip": "Trigger ATEM cut, auto, program/preview, etc."
    }
  ]
}
