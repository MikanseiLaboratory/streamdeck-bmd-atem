{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 3,
  "Author": "未完成成果物研究所",
  "CodePath": "streamdeck-atem",
  "CodePathMac": "streamdeck-atem",
  "CodePathWin": "streamdeck-atem.exe",
  "Description": "Control Blackmagic ATEM switchers from Stream Deck.",
  "Icon": "Images/icon",
  "Name": "ATEM Control",
  "Version": "0.2.0.0",
  "UUID": "dev.miseinul.atem",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.9"
  },
  "Category": "ATEM Control",
  "CategoryIcon": "Images/icon",
  "Profiles": [],
  "Actions": [
    {
      "UUID": "dev.miseinul.atem.cut",
      "Icon": "Images/icon",
      "Name": "ATEM Cut",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Perform a CUT transition on the configured ATEM ME."
    },
    {
      "UUID": "dev.miseinul.atem.auto",
      "Icon": "Images/icon",
      "Name": "ATEM Auto",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Perform an AUTO transition on the configured ATEM ME."
    },
    {
      "UUID": "dev.miseinul.atem.programinput",
      "Icon": "Images/icon",
      "Name": "ATEM Program Input",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Switch the ATEM program bus to the configured input."
    },
    {
      "UUID": "dev.miseinul.atem.previewinput",
      "Icon": "Images/icon",
      "Name": "ATEM Preview Input",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Switch the ATEM preview bus to the configured input."
    },
    {
      "UUID": "dev.miseinul.atem.cuttoblack",
      "Icon": "Images/icon",
      "Name": "ATEM Cut to Black",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Perform a CUT to black on the configured ATEM ME."
    },
    {
      "UUID": "dev.miseinul.atem.fadetoblack",
      "Icon": "Images/icon",
      "Name": "ATEM Fade to Black",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Toggle FADE TO BLACK on the configured ATEM ME."
    },
    {
      "UUID": "dev.miseinul.atem.auxoutput",
      "Icon": "Images/icon",
      "Name": "ATEM AUX Output",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Set AUX source",
          "Rotate": "Cycle AUX source"
        }
      },
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Set the source for an AUX bus output."
    },
    {
      "UUID": "dev.miseinul.atem.dskauto",
      "Icon": "Images/icon",
      "Name": "ATEM DSK Auto",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Trigger DSK auto transition."
    },
    {
      "UUID": "dev.miseinul.atem.dskonair",
      "Icon": "Images/icon",
      "Name": "ATEM DSK On Air",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Toggle or set DSK on-air state."
    },
    {
      "UUID": "dev.miseinul.atem.dskcut",
      "Icon": "Images/icon",
      "Name": "ATEM DSK Cut Source",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Set DSK cut source."
    },
    {
      "UUID": "dev.miseinul.atem.dskfill",
      "Icon": "Images/icon",
      "Name": "ATEM DSK Fill Source",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "Images/icon",
          "TitleAlignment": "middle"
        }
      ],
      "Tooltip": "Set DSK fill source."
    }
  ],
  "PropertyInspectorPath": "ui/index.html"
}
